 /* entry_list */
 static INLINE void section_entry_list_Insert(unsigned int SecNum, Word_t Index)
 {
+    // An entry at or past the end of a code section (e.g. the address after a call
+    // that ends the section) has no instruction to disassemble.
+    if (section[SecNum].type == ST_CODE && Index >= section[SecNum].size)
+    {
+        fprintf(stderr, "Warning: entry past end of section ignored - %i - 0x%x\n", SecNum, (unsigned int)Index);
+        return;
+    }
+
     OSet_Set(&section[SecNum].entry_list, Index);
 }
 
