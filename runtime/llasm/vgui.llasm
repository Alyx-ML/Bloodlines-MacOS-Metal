;; Entry points for native replacements of GameUI's vgui routines (runtime/bl_vgui.c).
include llasm.llinc
include asm-calls.llinc

funcv bl_vgui_GetCursorLine_c $

proc bl_vgui_GetCursorLine public
        call bl_vgui_GetCursorLine_c $
        Call_Asm_Return 0
endp

funcv bl_vgui_VisualReset_c $
funcv bl_vgui_AddPage_c $
funcv bl_vgui_VisualDestroy_c $

proc bl_vgui_VisualReset public
        call bl_vgui_VisualReset_c $
        Call_Asm_Return 0
endp

proc bl_vgui_VisualDestroy public
        call bl_vgui_VisualDestroy_c $
        Call_Asm_Return 0
endp

proc bl_vgui_AddPage public
        call bl_vgui_AddPage_c $
        Call_Asm_Return 2
endp

; Tooltip::ShowTooltip(panel) (thiscall): nothing is shown.
proc bl_vgui_ShowTooltip public
        Call_Asm_Return 1
endp
