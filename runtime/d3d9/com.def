# COM interfaces the runtime implements for guest code, in vtable order (d3d9.h).
#
#   interface <Name> [: <Base>]     methods of Base come first and keep Base's handler
#   <Method> <args>                 args = stack arguments after `this` (all stdcall)
#
# tools/gen_com.py turns this into llasm thunks (com_<Iface>_<Method>), weak trapping
# C handlers bl_<Iface>_<Method>_c(this, ...) and bl_vtbl_<Iface>() vtable builders.

interface IUnknown
QueryInterface 2
AddRef 0
Release 0

