# Windows imports provided by the runtime.
#
# <dll>!<name>  <stack args>  <cdecl|stdcall>  <C handler or -> [ret]
#
# The handler receives the stack arguments as uint32_t (guest addresses stay guest
# addresses) and returns eax when `ret` is given. `-` means not implemented yet:
# the import traps with its name, so missing pieces show up at run time.
# gen_imports.py turns this file into build/runtime/imports.llasm.

msvcrt!malloc        1 cdecl  bl_msvcrt_malloc  ret
msvcrt!free          1 cdecl  bl_msvcrt_free
msvcrt!_errno        0 cdecl  bl_msvcrt_errno   ret
msvcrt!_initterm     2 cdecl  bl_msvcrt_initterm
msvcrt!_vsnprintf    4 cdecl  bl_msvcrt_vsnprintf ret
msvcrt!sprintf       2 cdecl  bl_msvcrt_sprintf ret
msvcrt!fprintf       2 cdecl  -
msvcrt!fopen         2 cdecl  -
msvcrt!_fdopen       2 cdecl  -
msvcrt!fclose        1 cdecl  -
msvcrt!fflush        1 cdecl  -
msvcrt!fseek         3 cdecl  -
msvcrt!ftell         1 cdecl  -
msvcrt!fread         4 cdecl  -
msvcrt!fwrite        4 cdecl  -
msvcrt!fputc         2 cdecl  -
msvcrt!clearerr      1 cdecl  -
